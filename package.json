{
  "name": "natex",
  "private": true,
  "version": "3.0.0",
  "description": "Write LaTeX in Quill-based text editors, with a live preview.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NWelde/Natex.git"
  },
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "package": "npm run build && python3 scripts/package.py",
    "watch": "node build.mjs --watch",
    "test": "node --test \"tests/**/*.test.js\"",
    "demo": "node demo-video/run.mjs",
    "demo:login": "node demo-video/login.mjs"
  },
  "dependencies": {
    "katex": "0.16.47"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "esbuild": "0.28.2",
    "playwright-core": "^1.64.1"
  }
}
